{
  "manifest_version": 3,
  "name": "LimeFaucet Automation",
  "version": "1.6.1",
  "description": "LimeFaucet otomasyon eklentisi v1.6.1 — SW state kaybına karşı 3 katmanlı dayanıklı sekme kapatma + enjeksiyon düzeltmesi.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*",
    "*://*.m.youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LimeFaucet Automation"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.limefaucet.com/*"
      ],
      "js": [
        "lib/db.js",
        "lib/dom-utils.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
